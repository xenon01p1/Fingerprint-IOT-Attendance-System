generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ======== ENUMS ========
enum CompanyStatus {
  active
  paused
  banned
}

enum EmployeeRole {
  regular
  supervisor
}

enum EmployeeCompanyStatus {
  active
  onLeave
  resigned
}

enum EmployeeStatus {
  active
  banned
  deleted
}

enum AttendanceType {
  checkIn
  checkOut
}

enum LogDeviceType {
  register
  finishRegister
  checkIn
  checkOut
  delete
}


// ======== MODELS ========

model Company {
  id        String        @id @default(cuid())
  name      String
  field     String
  address   String
  status    CompanyStatus @default(active)
  reason    String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  isDeleted Boolean  @default(false)

  // back relation
  devices   Device[]
  employees Employee[]
}

model Device {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  // foreign key
  companyId String

  // relations
  company Company @relation(fields: [companyId], references: [id])

  // back relation
  fingerprints Fingerprint[]
  attendances  Attendance[]
}

model Admin {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  email       String   @unique
  phoneNumber String   @unique
  refreshToken String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  isDeleted   Boolean  @default(false)
}

model Employee {
  id             String                @id @default(cuid())
  employeeNumber Int                   @unique
  fullname       String
  username       String                @unique
  password       String
  email          String                @unique
  phoneNumber    String                @unique
  refreshToken   String?
  role           EmployeeRole          @default(regular)
  employeeStatus EmployeeCompanyStatus @default(active)
  status         EmployeeStatus        @default(active)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt 
  isDeleted      Boolean  @default(false)

  // foreign key
  companyId String

  // relations
  company Company @relation(fields: [companyId], references: [id])

  // back relation
  fingerprints Fingerprint[]
  attendances  Attendance[]
}

model Fingerprint {
  id               String   @id @default(cuid())
  fingerPrintIndex Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // foreign key
  employeeId String
  deviceId   String

  // relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  // back relation
  logDevices LogDevice[]
}

model Attendance {
  id        String         @id @default(cuid())
  type      AttendanceType
  createdAt DateTime       @default(now())

  // foreign key
  employeeId String
  deviceId   String? // Changed to optional for manual admin entries

  // relation 
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   Device?  @relation(fields: [deviceId], references: [id], onDelete: SetNull) // Keeps logs safe if hardware is deleted

  @@index([employeeId])
  @@index([createdAt])
}

model LogDevice {
  id        String        @id @default(cuid())
  type      LogDeviceType
  createdAt DateTime      @default(now())

  // foreign key
  fingerprintId String

  // relation 
  fingerprint Fingerprint @relation(fields: [fingerprintId], references: [id], onDelete: Cascade)

}